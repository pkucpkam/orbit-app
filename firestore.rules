rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidTxWrite() {
      let d = request.resource.data;
      return d.amount is int
          && d.amount > 0
          && d.type in ['income', 'expense', 'transfer', 'saving']
          && d.monthKey is string
          && d.walletId is string;
    }

    // -------------------------------------------------------------------------
    // users/{uid}
    // -------------------------------------------------------------------------

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Transactions: validate chặt để chặn amount âm / số thực
      match /transactions/{txId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidTxWrite();
      }

      // Các sub-collection khác: owner được đọc/ghi
      match /{sub}/{docId} {
        allow read, write: if isOwner(uid)
          && sub in [
            'wallets',
            'categories',
            'budgets',
            'monthSummaries',
            'goals',
            'recurring',
            'stats'
          ];
      }
    }
  }
}
